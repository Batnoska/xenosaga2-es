msgid "Send Him My Love!"
msgstr "¡Hazle llegar mi amor!"

#. máximo 16 caracteres; 1 línea(s) de hasta 151 píxeles
#, fuzzy
msgctxt "No.1/Locate"
msgid "Second Miltia"
msgstr "Segunda Miltia"

