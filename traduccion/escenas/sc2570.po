msgid ""
msgstr ""
"Project-Id-Version: Xenosaga Episode II - traducción al español\n"
"Language: es_419\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Xeno-Source: 0:cf/en/sc2570.sbl\n"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#2"
msgid "HOW'S BUSINESS?"
msgstr "¿CÓMO VA EL NEGOCIO?"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#3"
msgid ""
"What?\n"
"Not bad, not bad."
msgstr ""
"¿Qué?\n"
"Nada mal, nada mal."

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#4"
msgid "OH, NO! YOU DON'T KNOW ANYTHING ABOUT BUSINESS!"
msgstr "¡OH, NO! ¡NO SABES NADA DE NEGOCIOS!"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#5"
msgid "OH, THAT'S GREAT! BUT I THINK YOU'RE SUPPOSED TO ASK ME THAT."
msgstr "¡OH, QUÉ BIEN! PERO CREO QUE ESO ME LO TENDRÍAS QUE PREGUNTAR TÚ A MÍ."

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#6"
msgid "I'M PRACTICING MY SALES PITCH BECAUSE I'LL NEED IT PRETTY SOON!"
msgstr "¡ESTOY PRACTICANDO MI DISCURSO DE VENTAS PORQUE MUY PRONTO LO VOY A NECESITAR!"

#, fuzzy
msgctxt "#7"
msgid "There is currently no droid selected for scanning. Canceling monitor switch input."
msgstr "Por el momento no hay ningún droide seleccionado para escanear. Se cancela la entrada del monitor."

#, fuzzy
msgctxt "#8"
msgid "Use of the monitor requires a Power Battery."
msgstr "Para usar el monitor se necesita una Batería de Energía."

#, fuzzy
msgctxt "#9"
msgid "Confirmed remaining Power Battery charge. Begin droid scan?"
msgstr "Se confirmó la carga restante de la Batería de Energía. ¿Empezar el escaneo del droide?"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#10"
msgid ""
"Begin scan!\n"
"Cancel scan!"
msgstr ""
"¡Empezar el escaneo!\n"
"¡Cancelar el escaneo!"

#, fuzzy
msgctxt "#11"
msgid "Beginning droid scan."
msgstr "Empezando el escaneo del droide."

#, fuzzy
msgctxt "#12"
msgid "Canceling droid scan."
msgstr "Se canceló el escaneo del droide."

#, fuzzy
msgctxt "#13"
msgid "The Power Battery lacks sufficient charge. Please try again after recharging it."
msgstr "La Batería de Energía no tiene carga suficiente. Inténtalo de nuevo después de recargarla."

#. habla: SPUMONI
#, fuzzy
msgctxt "#14"
msgid "ZAZA AND I ARE SIBLINGS! WE KNOW THIS BECAUSE OUR SERIAL NUMBERS ARE SEQUENTIAL!"
msgstr "¡ZAZA Y YO SOMOS HERMANOS! ¡LO SABEMOS PORQUE NUESTROS NÚMEROS DE SERIE SON CONSECUTIVOS!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#15"
msgid "ZAZA IS STUPID! HE ALWAYS GET TRICKED BY CAPTAIN MATTHEWS!"
msgstr "¡ZAZA ES UN TONTO! ¡EL CAPITÁN MATTHEWS SIEMPRE LO ENGAÑA!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#16"
msgid "HAVE YOU EVER LONGED TO BECOME A HUMAN, KOS-MOS?"
msgstr "¿ALGUNA VEZ DESEASTE CONVERTIRTE EN HUMANA, KOS-MOS?"

#, fuzzy
msgctxt "#17"
msgid ""
"I can act in such a way if the need arises.\n"
"That is not an option in my emotional program."
msgstr ""
"Puedo actuar de ese modo si es necesario.\n"
"Esa opción no está en mi programa emocional."

#. habla: SPUMONI
#, fuzzy
msgctxt "#18"
msgid "ZAZA WISHES HE WAS HUMAN. HE EVEN TALKS LIKE HUMANS. IS THIS A GOOD THING OR NOT?"
msgstr "ZAZA DESEA SER HUMANO. HASTA HABLA COMO LOS HUMANOS. ¿ESO ES BUENO O NO?"

#. habla: SPUMONI
#, fuzzy
msgctxt "#19"
msgid "I SEE. TO LONG FOR ANYTHING IS JUST ANOTHER PROGRAM FUNCTION FOR US."
msgstr "YA VEO. PARA NOSOTROS, DESEAR ALGO ES SOLO OTRA FUNCIÓN DEL PROGRAMA."

#. habla: SPUMONI
#, fuzzy
msgctxt "#20"
msgid "WHY HELLO CHAOS! WE'RE HAVING VERY NICE WEATHER TODAY."
msgstr "¡VAYA, HOLA, CHAOS! HOY HACE UN TIEMPO MUY LINDO."

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#21"
msgid ""
"Yes, we are.\n"
"There's no weather in space."
msgstr ""
"Sí, es cierto.\n"
"En el espacio no hay clima."

#. habla: SPUMONI
#, fuzzy
msgctxt "#22"
msgid "IT'S SO NICE OF YOU TO TAKE PART IN MY SMALL TALK."
msgstr "ES MUY AMABLE DE TU PARTE SEGUIRME LA CHARLA."

#. habla: SPUMONI
#, fuzzy
msgctxt "#23"
msgid "ZAZA TOLD ME THAT HUMANS TALK ABOUT THE WEATHER AS A WAY OF GREETING ONE ANOTHER, BUT I GUESS IT WAS A MISTAKE."
msgstr "ZAZA ME DIJO QUE LOS HUMANOS HABLAN DEL TIEMPO PARA SALUDARSE, PERO SUPONGO QUE FUE UN ERROR."

#. habla: SPUMONI
#, fuzzy
msgctxt "#24"
msgid "GET OUT OF THE WAY! DON'T WANDER AROUND IN TINY SPACES LIKE THIS!"
msgstr "¡FUERA DEL CAMINO! ¡NO ANDES DANDO VUELTAS EN LUGARES TAN ESTRECHOS!"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#25"
msgid ""
"I'm sorry.\n"
"What's your problem?"
msgstr ""
"Perdón.\n"
"¿Cuál es tu problema?"

#. habla: SPUMONI
#, fuzzy
msgctxt "#26"
msgid "DID I STARTLE YOU? I WAS JUST TRYING TO IMITATE HUMANS!"
msgstr "¿TE ASUSTÉ? ¡SOLO INTENTABA IMITAR A LOS HUMANOS!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#27"
msgid "I APOLOGIZE. I THOUGHT I WAS IMITATING HOW HUMANS TALK, BUT PERHAPS THAT WAS A RUDE WAY OF SPEAKING. I GUESS THIS IS WHAT HAPPENS WHEN I BASE MY SPEECH PATTERNS ON THE PEOPLE ABOARD THIS SHIP."
msgstr "TE PIDO DISCULPAS. CREÍA QUE ESTABA IMITANDO CÓMO HABLAN LOS HUMANOS, PERO QUIZÁ ERA UNA FORMA GROSERA DE HABLAR. SUPONGO QUE ESTO PASA POR BASAR MI FORMA DE HABLAR EN LA GENTE DE ESTA NAVE."

#. habla: SPUMONI
#, fuzzy
msgctxt "#28"
msgid "WHERE DID ZAZA GO?"
msgstr "¿ADÓNDE SE FUE ZAZA?"

#. habla: SPUMONI
#, fuzzy
msgctxt "#29"
msgid "I BET CAPTAIN MATTHEWS TOLD HIM SOMETHING WEIRD AGAIN!"
msgstr "¡SEGURO QUE EL CAPITÁN MATTHEWS LE DIJO OTRA COSA RARA!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#30"
msgid "ZAZA HAS BEEN TALKING ABOUT SEEING THE COMPANY WHERE SHION WORKS. WHERE IS HE TALKING ABOUT?"
msgstr "ZAZA ANDA DICIENDO QUE QUIERE CONOCER LA EMPRESA DONDE TRABAJA SHION. ¿DE QUÉ LUGAR HABLA?"

#. habla: SPUMONI
#, fuzzy
msgctxt "#31"
msgid "WHAT DID ZAZA LEARN IN THE OUTSIDE WORLD? IT IS FUN JUST THINKING ABOUT IT."
msgstr "¿QUÉ HABRÁ APRENDIDO ZAZA EN EL MUNDO EXTERIOR? DE SOLO PENSARLO ME DIVIERTO."

#. habla: SPUMONI
#, fuzzy
msgctxt "#32"
msgid "BUT I LACK ZAZA'S COURAGE. I AM SO USELESS."
msgstr "PERO NO TENGO EL VALOR DE ZAZA. SOY TAN INÚTIL."

#. habla: SPUMONI
#, fuzzy
msgctxt "#33"
msgid "KOS-MOS, YOU TRAVEL THE OUTSIDE WORLD LIKE HUMANS, BUT DO YOU EVER FEEL NERVOUS ABOUT IT?"
msgstr "KOS-MOS, TÚ RECORRES EL MUNDO EXTERIOR COMO LOS HUMANOS, PERO ¿ALGUNA VEZ TE PONES NERVIOSA?"

#. habla: SPUMONI
#, fuzzy
msgctxt "#34"
msgid "I SEEM TO WORRY TOO MUCH EVEN THOUGH I AM A DROID."
msgstr "PARECE QUE ME PREOCUPO DEMASIADO, AUNQUE SEA UN DROIDE."

#. habla: SPUMONI
#, fuzzy
msgctxt "#35"
msgid "HI, CHAOS! MY BROTHER, ZAZA, FINISHED HIS GREAT ADVENTURE AND RETURNED SAFELY TO THE ELSA."
msgstr "¡HOLA, CHAOS! MI HERMANO ZAZA TERMINÓ SU GRAN AVENTURA Y VOLVIÓ SANO Y SALVO AL ELSA."

#. habla: SPUMONI
#, fuzzy
msgctxt "#36"
msgid "I'M VERY PROUD OF ZAZA. HE SHOWED THAT WE DROIDS CAN DO ANYTHING IF WE TRY!"
msgstr "ESTOY MUY ORGULLOSO DE ZAZA. ¡DEMOSTRÓ QUE LOS DROIDES PODEMOS HACER CUALQUIER COSA SI NOS LO PROPONEMOS!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#37"
msgid "ZAZA HAS FINALLY RETURNED TO NORMAL!"
msgstr "¡ZAZA POR FIN VOLVIÓ A LA NORMALIDAD!"

#. habla: PANACHE
#, fuzzy
msgctxt "#38"
msgid "DO YOU KNOW ABOUT CAPTAIN MATTHEWS' SHIP'S LOG?"
msgstr "¿CONOCES LA BITÁCORA DE LA NAVE DEL CAPITÁN MATTHEWS?"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#39"
msgid ""
"Log? No, I don't.\n"
"Yeah, I know about it."
msgstr ""
"¿Bitácora? No, no la conozco.\n"
"Sí, la conozco."

#. habla: PANACHE
#, fuzzy
msgctxt "#40"
msgid "CAPTAIN MATTHEWS IS A GREAT MAN. HE MAINTAINS A SHIP'S LOG. I HAVE SEEN IT BEFORE, AND IT IS FILLED WITH ONE ADVENTURE AFTER ANOTHER! THE RECOUNTING OF HIS ONE-ON-ONE BATTLE WITH A GIANT SPACE SHARK WAS TRULY THRILLING!"
msgstr "EL CAPITÁN MATTHEWS ES UN GRAN HOMBRE. LLEVA UNA BITÁCORA DE LA NAVE. LA VI UNA VEZ, ¡Y ESTÁ LLENA DE UNA AVENTURA TRAS OTRA! ¡EL RELATO DE SU DUELO MANO A MANO CONTRA UN TIBURÓN ESPACIAL GIGANTE FUE REALMENTE EMOCIONANTE!"

#. habla: PANACHE
#, fuzzy
msgctxt "#41"
msgid "OH?! THEN YOU KNOW ABOUT THE GREAT ADVENTURES WITHIN IT!"
msgstr "¡¿OH?! ¡ENTONCES CONOCES LAS GRANDES AVENTURAS QUE CONTIENE!"

#. habla: PANACHE
#, fuzzy
msgctxt "#42"
msgid "THIS IS A MAINTENANCE ROOM FOR DROIDS. THE MONITOR IN FRONT IS A DEVICE THAT CHECKS OUR MEMORY BANKS."
msgstr "ESTA ES UNA SALA DE MANTENIMIENTO DE DROIDES. EL MONITOR DE ENFRENTE ES UN DISPOSITIVO QUE REVISA NUESTROS BANCOS DE MEMORIA."

#. habla: PANACHE
#, fuzzy
msgctxt "#43"
msgid "IT MAY BE DIFFICULT TO TUNE A CUSTOM ANDROID LIKE YOU, KOS-MOS."
msgstr "PUEDE SER DIFÍCIL AJUSTAR A UNA ANDROIDE PERSONALIZADA COMO TÚ, KOS-MOS."

#. habla: PANACHE
#, fuzzy
msgctxt "#44"
msgid "DID YOU KNOW THAT THE LOHENGRIN-CLASS SPACE CRUISERS ARE CONSIDERED LUXURIOUS? NATURALLY, THE COST OF UPKEEP IS VERY HIGH. IT IS A MYSTERY HOW SOMEONE LIKE CAPTAIN MATTHEWS, WHO IS PERPETUALLY IN DEBT, COULD HAVE A SHIP LIKE THIS."
msgstr "¿SABÍAS QUE LOS CRUCEROS ESPACIALES CLASE LOHENGRIN SE CONSIDERAN DE LUJO? NATURALMENTE, SU MANTENIMIENTO ES MUY CARO. ES UN MISTERIO CÓMO ALGUIEN COMO EL CAPITÁN MATTHEWS, QUE VIVE ENDEUDADO, PUEDE TENER UNA NAVE ASÍ."

#. habla: PANACHE
#, fuzzy
msgctxt "#45"
msgid "CHAOS, YOU KNOW THAT CAPTAIN MATTHEWS IS BROKE, RIGHT? I GUESS HIS DEBT NEVER DECREASES BECAUSE HE IS ON A HIGH-CLASS SHIP LIKE THIS."
msgstr "CHAOS, SABES QUE EL CAPITÁN MATTHEWS ESTÁ EN BANCARROTA, ¿NO? SUPONGO QUE SU DEUDA NUNCA BAJA PORQUE ANDA EN UNA NAVE DE LUJO COMO ESTA."

#. habla: PANACHE
#, fuzzy
msgctxt "#46"
msgid "WOULD YOU LIKE ME TO EXPLAIN THIS MONITOR?"
msgstr "¿QUIERES QUE TE EXPLIQUE ESTE MONITOR?"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#47"
msgid ""
"Yes\n"
"No"
msgstr ""
"Sí\n"
"No"

#. habla: PANACHE
#, fuzzy
msgctxt "#48"
msgid "THE MONITOR ALLOWS A VISUAL EXAMINATION OF A DROID'S MEMORY. HOWEVER, THE DEVICE REQUIRES A VAST AMOUNT OF POWER. THE ELSA HAS A SELF-GENERATING POWER SYSTEM, BUT USING THIS MONITOR REQUIRES CUTTING DOWN ALL POWER TO THE REST OF THE SHIP. THEREFORE, CAPTAIN MATTHEWS RARELY SCANS OUR MEMORY. WE ALSO HAVE A SELF-ANALYSIS PROGRAM, SO UNLESS THERE IS A SEVERE MALFUNCTION, THIS MONITOR WILL NOT BE USED."
msgstr "EL MONITOR PERMITE EXAMINAR VISUALMENTE LA MEMORIA DE UN DROIDE. SIN EMBARGO, EL DISPOSITIVO NECESITA UNA ENORME CANTIDAD DE ENERGÍA. EL ELSA TIENE UN SISTEMA DE ENERGÍA AUTOGENERADA, PERO USAR ESTE MONITOR OBLIGA A CORTAR TODA LA ENERGÍA DEL RESTO DE LA NAVE. POR ESO, EL CAPITÁN MATTHEWS CASI NUNCA ESCANEA NUESTRA MEMORIA. ADEMÁS TENEMOS UN PROGRAMA DE AUTOANÁLISIS, ASÍ QUE, SALVO UNA AVERÍA GRAVE, ESTE MONITOR NO SE USA."

#. habla: PANACHE
#, fuzzy
msgctxt "#49"
msgid "YOU ARE RIGHT. IT'S NOT LIKE YOU WOULD BENEFIT FROM LEARNING ABOUT THIS MONITOR."
msgstr "TIENES RAZÓN. NO ES QUE TE VAYA A SERVIR DE ALGO SABER SOBRE ESTE MONITOR."

#. habla: PANACHE
#, fuzzy
msgctxt "#50"
msgid "IS THERE SOMETHING I CAN DO FOR YOU?"
msgstr "¿PUEDO HACER ALGO POR TI?"

#, fuzzy
msgctxt "#51"
msgid ""
"Where can we get a battery?\n"
"How much power is left in the battery?"
msgstr ""
"¿Dónde conseguimos una batería?\n"
"¿Cuánta carga le queda a la batería?"

#. habla: PANACHE
#, fuzzy
msgctxt "#52"
msgid "YOU NEED A PRETTY POWERFUL BATTERY TO OPERATE THIS MONITOR. A VECTOR POWER BATTERY WOULD BE IDEAL."
msgstr "PARA HACER FUNCIONAR ESTE MONITOR HACE FALTA UNA BATERÍA BASTANTE POTENTE. UNA BATERÍA DE ENERGÍA VECTOR SERÍA IDEAL."

#. habla: PANACHE
#, fuzzy
msgctxt "#53"
msgid "YOU DO NOT HAVE A POWER BATTERY."
msgstr "NO TIENES UNA BATERÍA DE ENERGÍA."

#. habla: PANACHE
#, fuzzy
msgctxt "#54"
msgid "YOU CAN USE IT FIVE MORE TIMES."
msgstr "PUEDES USARLA CINCO VECES MÁS."

#. habla: PANACHE
#, fuzzy
msgctxt "#55"
msgid "YOU CAN USE IT FOUR MORE TIMES."
msgstr "PUEDES USARLA CUATRO VECES MÁS."

#. habla: PANACHE
#, fuzzy
msgctxt "#56"
msgid "YOU CAN USE IT THREE MORE TIMES."
msgstr "PUEDES USARLA TRES VECES MÁS."

#. habla: PANACHE
#, fuzzy
msgctxt "#57"
msgid "YOU CAN USE IT TWO MORE TIMES."
msgstr "PUEDES USARLA DOS VECES MÁS."

#. habla: PANACHE
#, fuzzy
msgctxt "#58"
msgid "YOU CAN USE IT ONE MORE TIME."
msgstr "PUEDES USARLA UNA VEZ MÁS."

#. habla: PANACHE
#, fuzzy
msgctxt "#59"
msgid "THERE IS NO CHARGE REMAINING IN THE POWER BATTERY. PLEASE TRY AGAIN AFTER YOU'VE RECHARGED IT."
msgstr "A LA BATERÍA DE ENERGÍA NO LE QUEDA CARGA. INTÉNTALO DE NUEVO DESPUÉS DE RECARGARLA."

#. habla: PANACHE
#, fuzzy
msgctxt "#60"
msgid "SOME OF US WERE ACQUIRED HASTILY FOR THE ELSA'S REPAIR WORK."
msgstr "A ALGUNOS DE NOSOTROS NOS CONSIGUIERON A LAS APURADAS PARA LAS REPARACIONES DEL ELSA."

#. habla: PANACHE
#, fuzzy
msgctxt "#61"
msgid "IT SEEMS THE OLD MAN ON THE FLOOR BELOW WAS ALSO ACQUIRED HASTILY FOR ELSA'S REPAIR WORK."
msgstr "PARECE QUE AL VIEJO DEL PISO DE ABAJO TAMBIÉN LO CONSIGUIERON A LAS APURADAS PARA LAS REPARACIONES DEL ELSA."

#. habla: PANACHE
#, fuzzy
msgctxt "#62"
msgid "THOUGH CAPTAIN MATTHEWS SAYS THAT HE DOESN'T REMEMBER ACQUIRING THE OLD MAN."
msgstr "AUNQUE EL CAPITÁN MATTHEWS DICE QUE NO RECUERDA HABER CONSEGUIDO AL VIEJO."

#. habla: GIMLET
#, fuzzy
msgctxt "#63"
msgid "HAHAHAHAHAHA! I AM THE STRONGEST DROID ON THE ELSA!"
msgstr "¡JAJAJAJAJAJA! ¡SOY EL DROIDE MÁS FUERTE DEL ELSA!"

#. habla: GIMLET
#, fuzzy
msgctxt "#64"
msgid "HOW ABOUT IT ZIGGY? WANNA CHALLENGE ME TO A FIGHT? NOT THAT THERE'S A CHANCE THAT YOU'D WIN AGAINST ME!"
msgstr "¿QUÉ DICES, ZIGGY? ¿QUIERES DESAFIARME A UNA PELEA? ¡NO ES QUE TENGAS ALGUNA POSIBILIDAD DE GANARME!"

#. habla: GIMLET
#, fuzzy
msgctxt "#65"
msgid "HEY, DON'T FALL IN LOVE WITH ME BECAUSE I'M STRONG, BABY! I'M A LOT TOUGHER THAN I LOOK."
msgstr "¡OYE, NO TE ENAMORES DE MÍ PORQUE SOY FUERTE, PRECIOSA! SOY MUCHO MÁS DURO DE LO QUE PAREZCO."

#. habla: GIMLET
#, fuzzy
msgctxt "#66"
msgid "YOU NEVER KNOW. WHEN YOU'RE IN TROUBLE, I MIGHT JUST COME AND SAVE YOU!"
msgstr "NUNCA SE SABE. ¡CUANDO ESTÉS EN PROBLEMAS, QUIZÁ VAYA A SALVARTE!"

#. habla: GIMLET
#, fuzzy
msgctxt "#67"
msgid "CHAOS. I'VE HEARD ABOUT YOU! SO, YOU'RE PRETTY STRONG, HUH?"
msgstr "CHAOS. ¡ME HABLARON DE TI! ASÍ QUE ERES BASTANTE FUERTE, ¿EH?"

#. habla: GIMLET
#, fuzzy
msgctxt "#68"
msgid "YOU MAY BE STRONG, BUT I'LL BET YOU'RE THE TYPE THAT RUNS AWAY WHEN THINGS GO BAD! WELL, I'M NOT LIKE THAT! I'LL TAKE ANYONE HEAD-ON, NO MATTER WHAT!"
msgstr "QUIZÁ SEAS FUERTE, ¡PERO APUESTO A QUE ERES DE LOS QUE SALEN CORRIENDO CUANDO LAS COSAS SE PONEN FEAS! ¡BUENO, YO NO SOY ASÍ! ¡ME ENFRENTO CARA A CARA CON CUALQUIERA, PASE LO QUE PASE!"

#. habla: GIMLET
#, fuzzy
msgctxt "#69"
msgid "MORE THIEVES HAVE BEEN TARGETING SHIPS LATELY! WELL, AS LONG AS I'M ON THE ELSA, IT'S SMOOTH SAILING! NOT THAT THE ELSA EVER SAILS SMOOTHLY."
msgstr "¡EN LOS ÚLTIMOS TIEMPOS HAY MÁS LADRONES QUE ATACAN NAVES! ¡BUENO, MIENTRAS YO ESTÉ EN EL ELSA, VIENTO EN POPA! AUNQUE EL ELSA NUNCA VA VIENTO EN POPA."

#. habla: GIMLET
#, fuzzy
msgctxt "#70"
msgid "IT'S PRETTY LOW EVEN FOR SCUM LIKE THAT TO TARGET DOCKED SHIPS."
msgstr "ATACAR NAVES ATRACADAS ES BAJO INCLUSO PARA ESA ESCORIA."

#. habla: GIMLET
#, fuzzy
msgctxt "#71"
msgid "HAHAHA! A THIEF GOT INTO THE SHIP!"
msgstr "¡JAJAJA! ¡UN LADRÓN SE METIÓ EN LA NAVE!"

#. habla: GIMLET
#, fuzzy
msgctxt "#72"
msgid "DAMMIT! I CAN'T BELIEVE WHAT HAPPENED TO ME! MY MEMORY IS DAMAGED, SO I DON'T REMEMBER THE THIEF'S FACE!"
msgstr "¡MALDICIÓN! ¡NO PUEDO CREER LO QUE ME PASÓ! ¡TENGO LA MEMORIA DAÑADA, ASÍ QUE NO RECUERDO LA CARA DEL LADRÓN!"

#. habla: GIMLET
#, fuzzy
msgctxt "#73"
msgid "USE A POWER BATTERY AND RESTORE MY MEMORY!"
msgstr "¡USEN UNA BATERÍA DE ENERGÍA Y RESTAUREN MI MEMORIA!"

#. habla: GIMLET
#, fuzzy
msgctxt "#74"
msgid "MAN, THAT WAS EMBARRASSING! BUT I WAS SO CLOSE TO TEARING THAT THIEF APART! REALLY!"
msgstr "¡UF, QUÉ VERGÜENZA! ¡PERO ESTUVE A NADA DE HACER PEDAZOS A ESE LADRÓN! ¡DE VERDAD!"

#. habla: GIMLET
#, fuzzy
msgctxt "#75"
msgid "I SWEAR, NEXT TIME, THAT THIEF IS GOING TO REGRET IT!"
msgstr "¡LO JURO: LA PRÓXIMA VEZ, ESE LADRÓN SE VA A ARREPENTIR!"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#76"
msgid "PLEASE HELP K-2 REDUCE CAPTAIN MATTHEWS' DEBT AS QUICKLY AS POSSIBLE."
msgstr "POR FAVOR, AYUDEN A K-2 A REDUCIR LO ANTES POSIBLE LA DEUDA DEL CAPITÁN MATTHEWS."

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#77"
msgid "WHERE IS K-2? HE IS WORKING HARD AT THE SECOND MILTIA SPACE PORT!"
msgstr "¿DÓNDE ESTÁ K-2? ¡ESTÁ TRABAJANDO DURO EN EL PUERTO ESPACIAL DE SEGUNDA MILTIA!"

#. habla: ZAZA
#, fuzzy
msgctxt "#78"
msgid "*SIGH* I ENVY THE FREEDOM YOU HUMANS HAVE."
msgstr "*SUSPIRO* ENVIDIO LA LIBERTAD QUE TIENEN USTEDES, LOS HUMANOS."

#. habla: ZAZA
#, fuzzy
msgctxt "#79"
msgid "I WANT TO SEE THE OUTSIDE WORLD ONE DAY."
msgstr "ALGÚN DÍA QUIERO CONOCER EL MUNDO EXTERIOR."

#. habla: ZAZA
#, fuzzy
msgctxt "#80"
msgid "HMM. I HAVE LEARNED THAT IT IS TOUGH TO BE HUMAN! I WANT A TOUGH BODY LIKE YOURS, ZIGGY."
msgstr "HMM. ¡APRENDÍ QUE ES DIFÍCIL SER HUMANO! QUIERO UN CUERPO RESISTENTE COMO EL TUYO, ZIGGY."

#. habla: ZAZA
#, fuzzy
msgctxt "#81"
msgid "IF I HAD A STRONGER BODY, I COULD HAVE GONE ON MORE ADVENTURES!"
msgstr "¡SI TUVIERA UN CUERPO MÁS FUERTE, PODRÍA HABER VIVIDO MÁS AVENTURAS!"

#. habla: ZAZA
#, fuzzy
msgctxt "#82"
msgid "OH, KOS-MOS! PLEASE TELL ME ABOUT SOME GOOD PARTS FOR REMODELING SOMETIME!"
msgstr "¡OH, KOS-MOS! ¡ALGÚN DÍA CUÉNTAME DE BUENAS PIEZAS PARA REMODELARME!"

#. habla: ZAZA
#, fuzzy
msgctxt "#83"
msgid "I WANT TO BE ULTRA-CUSTOMIZED SO I CAN WIPE OUT EVIL IN ONE BLOW!"
msgstr "¡QUIERO QUE ME PERSONALICEN AL MÁXIMO PARA PODER ACABAR CON EL MAL DE UN SOLO GOLPE!"

#. habla: ZAZA
#, fuzzy
msgctxt "#84"
msgid "ONCE YOU EXPERIENCE THE OUTSIDE WORLD, YOU GET HOOKED."
msgstr "CUANDO CONOCES EL MUNDO EXTERIOR, TE ENGANCHAS."

#. habla: ZAZA
#, fuzzy
msgctxt "#85"
msgid "SPUMONI MAY THINK THAT I'VE CHANGED MY WAYS, BUT HE'S WRONG! I'M GOING TO GET OFF THE ELSA AGAIN AND GO ON ANOTHER BIG ADVENTURE SOME DAY!"
msgstr "¡QUIZÁ SPUMONI CREA QUE SENTÉ CABEZA, PERO SE EQUIVOCA! ¡ALGÚN DÍA VOY A BAJARME OTRA VEZ DEL ELSA Y A VIVIR OTRA GRAN AVENTURA!"

#. habla: ZAZA
#, fuzzy
msgctxt "#86"
msgid "YOU MUST THINK IT IS STRANGE FOR US DROIDS TO DREAM, BUT WE DO! THOUGH IT IS DIFFERENT FROM WHAT HUMANS SEE WHEN THEY ARE SLEEPING."
msgstr "QUIZÁ TE PAREZCA RARO QUE LOS DROIDES SOÑEMOS, ¡PERO SOÑAMOS! AUNQUE ES DISTINTO DE LO QUE VEN LOS HUMANOS CUANDO DUERMEN."

#. habla: ZAZA
#, fuzzy
msgctxt "#87"
msgid "THE DREAMS WE DREAM ARE SOMETHING LIKE A \"LONGING\" TO BECOME HUMANS."
msgstr "LOS SUEÑOS QUE SOÑAMOS SON ALGO ASÍ COMO EL \"ANHELO\" DE CONVERTIRNOS EN HUMANOS."

#. habla: CABRILLO
#, fuzzy
msgctxt "#88"
msgid "OH, HELLO! I'M CABRILLO, THE ONLY FEMALE DROID ON THE ELSA! I ACTUALLY KNOW ABOUT SOMETHING QUITE UNLADYLIKE AND CRUDE! WHAT'S THAT? YOU'RE GOING TO MAKE A LADY LIKE ME SAY IT?! WELL, IT'S A SWIMSUIT FOR THE OLD MAN DOWN BELOW!"
msgstr "¡OH, HOLA! ¡SOY CABRILLO, LA ÚNICA DROIDE MUJER DEL ELSA! ¡EN REALIDAD SÉ DE ALGO NADA PROPIO DE UNA DAMA Y BASTANTE VULGAR! ¿QUÉ? ¡¿VAS A HACER QUE UNA DAMA COMO YO LO DIGA?! BUENO, ¡ES UN TRAJE DE BAÑO PARA EL VIEJO DE ABAJO!"

#. habla: CABRILLO
#, fuzzy
msgctxt "#89"
msgid "OH, HELLO! I'M CABRILLO, THE ONLY FEMALE DROID ON THE ELSA! OH! YOU'VE GOT THAT CRUDE THING. YES, THE OLD MAN'S SWIMSUIT!"
msgstr "¡OH, HOLA! ¡SOY CABRILLO, LA ÚNICA DROIDE MUJER DEL ELSA! ¡OH! TIENES ESA COSA VULGAR. SÍ, ¡EL TRAJE DE BAÑO DEL VIEJO!"

#. habla: CABRILLO
#, fuzzy
msgctxt "#90"
msgid "I HEARD THAT BELONGS TO THE OLD MAN DOWN BELOW, BUT HE'S A LOT MORE MODEST THAN HE SEEMS! SO, HE DOESN'T WANT TO CHANGE IN FRONT OF OTHER PEOPLE! IF YOU WANT HIM TO WEAR IT, TALK TO ME! ♪"
msgstr "ESCUCHÉ QUE ES DEL VIEJO DE ABAJO, ¡PERO ES MUCHO MÁS PUDOROSO DE LO QUE PARECE! ¡ASÍ QUE NO QUIERE CAMBIARSE DELANTE DE OTRAS PERSONAS! SI QUIERES QUE SE LO PONGA, ¡HABLA CONMIGO! ♪"

#. habla: CABRILLO
#, fuzzy
msgctxt "#91"
msgid "OH! DO YOU WANT ME TO CHANGE THE OLD MAN'S CLOTHES?"
msgstr "¡OH! ¿QUIERES QUE LE CAMBIE LA ROPA AL VIEJO?"

#. habla: CABRILLO
#, fuzzy
msgctxt "#92"
msgid "OKAY! SET TRANSFORMATION! ♪ "
msgstr "¡MUY BIEN! ¡PREPARANDO TRANSFORMACIÓN! ♪"

#, fuzzy
msgctxt "#93"
msgid "The Professor changed into his swimsuit!"
msgstr "¡El Profesor se puso el traje de baño!"

#. habla: CABRILLO
#, fuzzy
msgctxt "#94"
msgid "IF YOU WANT TO CHECK IT OUT, GO DOWN AND SEE HIM WITH YOUR OWN EYES! ♪"
msgstr "SI QUIERES VERLO, ¡BAJA Y MÍRALO CON TUS PROPIOS OJOS! ♪"

#. habla: CABRILLO
#, fuzzy
msgctxt "#95"
msgid "IF YOU WANT TO CHANGE THE OLD MAN'S CLOTHES, JUST COME TALK TO ME! ♪"
msgstr "SI QUIERES CAMBIARLE LA ROPA AL VIEJO, ¡SOLO VEN A HABLAR CONMIGO! ♪"

#, fuzzy
msgctxt "#96"
msgid "The Professor returned to his normal clothes!"
msgstr "¡El Profesor volvió a su ropa de siempre!"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#97"
msgid "K-2 AND I ARE THINKING ABOUT OPENING A SHOP ON THE ELSA. HOWEVER, BECAUSE CAPTAIN MATTHEWS IS DEEPLY IN DEBT, HE WON'T EVEN LOOK AT THE ITEMS THAT WE ARE SELLING! SO, K-2 AND I WANT TO HELP THE CAPTAIN REPAY HIS DEBT AND BECOME RICH! WHAT DO YOU THINK? WILL YOU PROMISE TO HELP CAPTAIN MATTHEWS REPAY HIS DEBT?"
msgstr "K-2 Y YO ESTAMOS PENSANDO EN ABRIR UNA TIENDA EN EL ELSA. SIN EMBARGO, COMO EL CAPITÁN MATTHEWS ESTÁ MUY ENDEUDADO, ¡NI SIQUIERA MIRA LOS ARTÍCULOS QUE VENDEMOS! ASÍ QUE K-2 Y YO QUEREMOS AYUDAR AL CAPITÁN A PAGAR SU DEUDA Y A HACERSE RICO. ¿QUÉ TE PARECE? ¿PROMETES AYUDAR AL CAPITÁN MATTHEWS A PAGAR SU DEUDA?"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#98"
msgid "THANK YOU FOR YOUR SUPPORT!"
msgstr "¡GRACIAS POR TU APOYO!"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#100"
msgid "WELL, WHAT YOU NEED TO DO IS HAND OVER ANY UNNECESSARY ITEMS AND ACCESSORIES TO K-2, WHO WILL THEN HAND THEM OVER TO A BUYER, AND THE TOTAL AMOUNT OF THE CAPTAIN'S DEBT WILL DECREASE! RIGHT NOW, THE DEBT IS AT A STAGGERING AMOUNT! WE'RE IN FOR A LONG HAUL, BUT JUST KEEP AT IT!"
msgstr "BUENO, LO QUE TIENES QUE HACER ES ENTREGARLE A K-2 LOS OBJETOS Y ACCESORIOS QUE NO NECESITES. ÉL SE LOS VA A ENTREGAR A UN COMPRADOR, ¡Y EL TOTAL DE LA DEUDA DEL CAPITÁN VA A BAJAR! AHORA MISMO, LA DEUDA ES DE UNA CIFRA ESCALOFRIANTE. ¡NOS ESPERA UN CAMINO LARGO, PERO NO TE RINDAS!"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#101"
msgid "OH, OKAY. WE WON'T FORCE YOU TO HELP US. IF YOU FEEL LIKE IT, PLEASE GO SEE K-2. HE SHOULD BE AT THE SPACE PORT IN SECOND MILTIA."
msgstr "AH, BUENO. NO TE VAMOS A OBLIGAR A AYUDARNOS. SI TIENES GANAS, POR FAVOR, VE A VER A K-2. DEBERÍA ESTAR EN EL PUERTO ESPACIAL DE SEGUNDA MILTIA."

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#102"
msgid "THANK YOU SO MUCH! THANKS TO YOU, CAPTAIN MATTHEWS HAS PAID BACK ALL OF HIS DEBT! CAPTAIN MATTHEWS PROVIDED ME WITH THIS BOOTH AS A REWARD!"
msgstr "¡MUCHÍSIMAS GRACIAS! ¡GRACIAS A TI, EL CAPITÁN MATTHEWS PAGÓ TODA SU DEUDA! ¡EL CAPITÁN MATTHEWS ME DIO ESTE PUESTO COMO RECOMPENSA!"

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#104"
msgid "AS AN EXPRESSION OF MY GRATITUDE, I HAVE A PRESENT FOR YOU!"
msgstr "¡COMO MUESTRA DE MI GRATITUD, TENGO UN REGALO PARA TI!"

#, fuzzy
msgctxt "#105"
msgid "You obtained Skill Upgrade E x40!"
msgstr "¡Obtuviste Mejora de Habilidad E x40!"

#, fuzzy
msgctxt "#106"
msgid "You can now use the Double Attack, \"Power Strike\"! Power Strike is a Double Attack for Ziggy and MOMO."
msgstr "¡Ahora puedes usar el Ataque Doble \"Golpe poderoso\"! Golpe poderoso es un Ataque Doble de Ziggy y MOMO."

#, fuzzy
msgctxt "#107"
msgid "You obtained Secret Key 19! This key opens the Level 3 Class G skill \"Ether Burst.\""
msgstr "¡Obtuviste la Llave Secreta 19! Esta llave desbloquea la habilidad de Clase G de nivel 3 \"Estallido de éter\"."

#, fuzzy
msgctxt "#108"
msgid "You can now use X-BUSTER! X-BUSTER is a special skill for KOS-MOS. "
msgstr "¡Ahora puedes usar X-BUSTER! X-BUSTER es una habilidad especial de KOS-MOS."

#. habla: KAMIKAZE
#, fuzzy
msgctxt "#109"
msgid "AND AS AN ADDED BONUS, I'LL GIVE YOU THIS AS WELL!"
msgstr "¡Y COMO EXTRA, TE DOY ESTO!"

#, fuzzy
msgctxt "#110"
msgid "You obtained Jin's Swimsuit!"
msgstr "¡Obtuviste el Traje de baño de Jin!"

#. habla: PANACHE
#, fuzzy
msgctxt "#111"
msgid "WE HAVE AN EMERGENCY! A THIEF HAS BROKEN INTO THE ELSA. AT FIRST, IT SEEMED LIKE THEY DIDN'T TAKE ANYTHING VALUABLE, BUT THEN WE FOUND OUT THE SHIP'S LOG HAD BEEN STOLEN! AND GIMLET, THE ONLY WITNESS, HAS TURNED INTO THAT HEAP OF METAL OVER THERE! IF GIMLET'S MEMORY IS RESTORED, IT'LL BE A VITAL CLUE TO FIND OUT WHO THE THIEF IS! IF WE COULD USE THE MONITOR IN THIS ROOM, IT WOULD BE NO PROBLEM TO RESTORE GIMLET'S MEMORY, BUT CONSIDERING OUR CURRENT SITUATION, IT IS UNREALISTIC TO CUT THE POWER TO THE REST OF THE SHIP. SO, WE NEED TO USE SOMETHING ELSE TO POWER THE MONITOR. WILL YOU HELP US TRY TO RESTORE GIMLET'S MEMORY?"
msgstr "¡TENEMOS UNA EMERGENCIA! UN LADRÓN SE METIÓ EN EL ELSA. AL PRINCIPIO PARECÍA QUE NO SE HABÍA LLEVADO NADA VALIOSO, ¡PERO DESPUÉS DESCUBRIMOS QUE HABÍAN ROBADO LA BITÁCORA DE LA NAVE! ¡Y GIMLET, EL ÚNICO TESTIGO, QUEDÓ CONVERTIDO EN ESE MONTÓN DE METAL DE ALLÁ! ¡SI SE RESTAURA LA MEMORIA DE GIMLET, VA A SER UNA PISTA CLAVE PARA SABER QUIÉN ES EL LADRÓN! SI PUDIÉRAMOS USAR EL MONITOR DE ESTA SALA, NO HABRÍA PROBLEMA PARA RESTAURAR LA MEMORIA DE GIMLET, PERO DADA NUESTRA SITUACIÓN ACTUAL, NO ES REALISTA CORTAR LA ENERGÍA DEL RESTO DE LA NAVE. ASÍ QUE TENEMOS QUE USAR OTRA COSA PARA ALIMENTAR EL MONITOR. ¿NOS AYUDAS A INTENTAR RESTAURAR LA MEMORIA DE GIMLET?"

#. habla: PANACHE
#, fuzzy
msgctxt "#112"
msgid "YOU WILL?! WE ARE COUNTING ON YOU!"
msgstr "¡¿DE VERDAD?! ¡CONTAMOS CONTIGO!"

#. habla: PANACHE
#, fuzzy
msgctxt "#113"
msgid "LET'S START BY FIRST FINDING A POWER SOURCE FOR THE MONITOR!"
msgstr "¡EMPECEMOS POR ENCONTRAR UNA FUENTE DE ENERGÍA PARA EL MONITOR!"

#. habla: PANACHE
#, fuzzy
msgctxt "#114"
msgid "OH. WE WOULD REALLY APPRECIATE YOUR HELP. IT'S A MATTER OF THE CAPTAIN'S HONOR TOO, YOU KNOW."
msgstr "OH. DE VERDAD NOS VENDRÍA BIEN TU AYUDA. TAMBIÉN ESTÁ EN JUEGO EL HONOR DEL CAPITÁN, ¿SABES?"

#. habla: SPUMONI
#, fuzzy
msgctxt "#115"
msgid "WE HAVE AN EMERGENCY! ZAZA HAS DISAPPEARED! I CAN'T FIND HIM ANYWHERE ON THE ELSA! PLEASE FIND ZAZA!"
msgstr "¡TENEMOS UNA EMERGENCIA! ¡ZAZA DESAPARECIÓ! ¡NO LO ENCUENTRO POR NINGÚN LADO EN EL ELSA! ¡POR FAVOR, ENCUENTREN A ZAZA!"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#116"
msgid ""
"Leave it to me!\n"
"No way!"
msgstr ""
"¡Déjamelo a mí!\n"
"¡Ni hablar!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#117"
msgid "PLEASE FIND ZAZA!"
msgstr "¡POR FAVOR, ENCUENTREN A ZAZA!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#118"
msgid "Y...YOU'RE HEARTLESS!"
msgstr "¡QU... QUÉ CORAZÓN DE PIEDRA!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#119"
msgid "ZAZA CAME BACK! THANK YOU VERY MUCH!"
msgstr "¡ZAZA VOLVIÓ! ¡MUCHÍSIMAS GRACIAS!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#120"
msgid "ZAZA WAS ABLE TO COME BACK SAFELY BECAUSE OF YOU. THIS IS FOR YOU FROM ZAZA AND ME. PLEASE TAKE IT."
msgstr "ZAZA PUDO VOLVER SANO Y SALVO GRACIAS A TI. ESTO ES PARA TI, DE PARTE DE ZAZA Y MÍA. POR FAVOR, ACÉPTALO."

#, fuzzy
msgctxt "#121"
msgid "You obtained Skill Upgrade D x20!"
msgstr "¡Obtuviste Mejora de Habilidad D x20!"

#, fuzzy
msgctxt "#122"
msgid "You obtained a Rejuvenator E!"
msgstr "¡Obtuviste un Elixir E!"

#. habla: SPUMONI
#, fuzzy
msgctxt "#123"
msgid "ZAZA SEEMS TO HAVE GAINED SOMETHING VERY IMPORTANT IN THE OUTSIDE WORLD. I WOULD LIKE TO VENTURE TO THE OUTSIDE WORLD SOME DAY AS WELL."
msgstr "PARECE QUE ZAZA GANÓ ALGO MUY IMPORTANTE EN EL MUNDO EXTERIOR. A MÍ TAMBIÉN ME GUSTARÍA AVENTURARME ALGÚN DÍA EN EL MUNDO EXTERIOR."

#, fuzzy
