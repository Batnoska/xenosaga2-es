msgctxt "#3"
msgid ""
"...\n"
"...\n"
"......\n"
"Zzzz..."
msgstr ""
"...\n"
"...\n"
"......\n"
"Zzzz..."

#. habla: Chad
#, fuzzy
msgctxt "#4"
msgid "I'm sorry. You can't use this elevator as it is currently undergoing inspection. Please wait patiently until we finish working on it."
msgstr "Lo siento. No puede usar este ascensor porque está en revisión. Por favor, espere con paciencia hasta que terminemos."

#. habla: Chad
#, fuzzy
msgctxt "#5"
msgid "I know it's terrible timing, but things just break down. I think we'll have it fixed soon, so hang on just a little longer."
msgstr "Sé que es el peor momento, pero las cosas se rompen. Creo que pronto lo vamos a tener arreglado, así que aguarde un poquito más."

#, fuzzy
msgctxt "#6"
msgid "Go down?"
msgstr "¿Bajar?"

