#. habla: ADONIS
#, fuzzy
msgctxt "#0"
msgid "MIX A REMEDY?"
msgstr "¿PREPARAR UN REMEDIO?"

#, fuzzy
msgctxt "#1"
msgid ""
"Begin mixing!\n"
"Cancel mixing!\n"
"Please tell me about making remedies!"
msgstr ""
"¡Empezar la mezcla!\n"
"¡Cancelar la mezcla!\n"
"¡Explícame cómo hacer remedios!"

#. habla: ADONIS
#, fuzzy
msgctxt "#2"
msgid ""
"PLEASE SET THE MIX RATIO.\n"
"LEFT: ORANGE JUICE\n"
"MIDDLE: TOMATO JUICE\n"
"RIGHT: COFFEE\n"
"PLEASE ADJUST THE THREE DIGITS SO THEY TOTAL SEVEN."
msgstr ""
"INDICA LA PROPORCIÓN DE LA MEZCLA.\n"
"IZQUIERDA: JUGO DE NARANJA\n"
"CENTRO: JUGO DE TOMATE\n"
"DERECHA: CAFÉ\n"
"AJUSTA LOS TRES DÍGITOS PARA QUE SUMEN SIETE."

#. habla: ADONIS
#, fuzzy
msgctxt "#3"
msgid "BEGINNING MIX..."
msgstr "EMPEZANDO LA MEZCLA..."

#. habla: ADONIS
#, fuzzy
msgctxt "#4"
msgid "MIX CANCELED."
msgstr "MEZCLA CANCELADA."

#. habla: ADONIS
#, fuzzy
msgctxt "#5"
msgid "WHAT WOULD YOU LIKE TO KNOW ABOUT?"
msgstr "¿QUÉ TE GUSTARÍA SABER?"

#. Opciones: una por línea. Mantener 4 líneas en el mismo orden.
#, fuzzy
msgctxt "#6"
msgid ""
"Mix ratio\n"
"Mix ratio total\n"
"Number of remedies remaining\n"
"Never mind"
msgstr ""
"La proporción\n"
"El total de la proporción\n"
"Los intentos restantes\n"
"Nada, gracias"

#. habla: ADONIS
#, fuzzy
msgctxt "#7"
msgid "THE DRINKS ARE FROM LEFT TO RIGHT: ORANGE JUICE, TOMATO JUICE, AND COFFEE."
msgstr "LAS BEBIDAS SON, DE IZQUIERDA A DERECHA: JUGO DE NARANJA, JUGO DE TOMATE Y CAFÉ."

#. habla: ADONIS
#, fuzzy
msgctxt "#8"
msgid "IN ORDER TO MAKE A REMEDY THE CAPTAIN CAN STAND, THE THREE DIGITS NEED TO ADD UP TO SEVEN."
msgstr "PARA HACER UN REMEDIO QUE EL CAPITÁN PUEDA TOLERAR, LOS TRES DÍGITOS TIENEN QUE SUMAR SIETE."

#. habla: ADONIS
#, fuzzy
msgctxt "#9"
msgid "YOU HAVE FIVE CHANCES TO MAKE A REMEDY."
msgstr "TIENES CINCO OPORTUNIDADES PARA HACER UN REMEDIO."

#. habla: ADONIS
#, fuzzy
msgctxt "#10"
msgid "YOU HAVE FOUR CHANCES TO MAKE A REMEDY."
msgstr "TIENES CUATRO OPORTUNIDADES PARA HACER UN REMEDIO."

#. habla: ADONIS
#, fuzzy
msgctxt "#11"
msgid "YOU HAVE THREE CHANCES TO MAKE A REMEDY."
msgstr "TIENES TRES OPORTUNIDADES PARA HACER UN REMEDIO."

#. habla: ADONIS
#, fuzzy
msgctxt "#12"
msgid "YOU HAVE TWO CHANCES TO MAKE A REMEDY."
msgstr "TIENES DOS OPORTUNIDADES PARA HACER UN REMEDIO."

#. habla: ADONIS
#, fuzzy
msgctxt "#13"
msgid "YOU HAVE ONE CHANCE TO MAKE A REMEDY."
msgstr "TIENES UNA OPORTUNIDAD PARA HACER UN REMEDIO."

#. habla: ADONIS
#, fuzzy
msgctxt "#14"
msgid "OKAY, LET'S DO IT."
msgstr "MUY BIEN, HAGÁMOSLO."

#. habla: ADONIS
#, fuzzy
msgctxt "#15"
msgid "YOU CAN ONLY MAKE ONE KIND OF REMEDY AT A TIME. PLEASE GO LISTEN TO THE MATTHEWS ROBOT'S ANALYSIS."
msgstr "SOLO PUEDES HACER UN TIPO DE REMEDIO A LA VEZ. POR FAVOR, VE A ESCUCHAR EL ANÁLISIS DEL ROBOT MATTHEWS."

#. habla: ADONIS
#, fuzzy
msgctxt "#16"
msgid "I REALLY NEED TO MAKE THIS REMEDY WORK."
msgstr "DE VERDAD NECESITO QUE ESTE REMEDIO FUNCIONE."

#. habla: ADONIS
#, fuzzy
msgctxt "#17"
msgid "YOU CAN'T MIX ANY MORE REMEDIES."
msgstr "YA NO PUEDES MEZCLAR MÁS REMEDIOS."

#. habla: ADONIS
#, fuzzy
msgctxt "#18"
msgid "HELLO, ZIGGY! I WANT TO BECOME STRONG LIKE YOU."
msgstr "¡HOLA, ZIGGY! QUIERO SER FUERTE COMO TÚ."

#. habla: ADONIS
#, fuzzy
msgctxt "#19"
msgid "I'M THE FAMOUS BARTENDER, ADONIS. DON'T YOU THINK IT'S THE PERFECT NAME FOR A HANDSOME BOY LIKE ME?"
msgstr "SOY EL FAMOSO BARMAN ADONIS. ¿NO TE PARECE EL NOMBRE PERFECTO PARA UN CHICO APUESTO COMO YO?"

#. habla: ADONIS
#, fuzzy
msgctxt "#20"
msgid "CAPTAIN MATTHEWS IS ALWAYS DRINKING. HE'S VERY PICKY ABOUT HIS LIQUOR."
msgstr "EL CAPITÁN MATTHEWS SIEMPRE ESTÁ BEBIENDO. ES MUY EXIGENTE CON SUS BEBIDAS."

#. habla: ADONIS
#, fuzzy
msgctxt "#21"
msgid "HELLO, KOS-MOS! SHALL I MAKE A COCKTAIL ESPECIALLY FOR YOU?"
msgstr "¡HOLA, KOS-MOS! ¿TE PREPARO UN CÓCTEL ESPECIAL?"

#. habla: ADONIS
#, fuzzy
msgctxt "#22"
msgid "WHAT? YOU DON'T DRINK? OH YEAH. NOW THAT I THINK ABOUT IT, NEITHER DO I."
msgstr "¿QUÉ? ¿NO BEBES? AH, SÍ. AHORA QUE LO PIENSO, YO TAMPOCO."

#. habla: ADONIS
#, fuzzy
msgctxt "#23"
msgid "I BET YOU DON'T DRINK TOO MUCH, CHAOS. I THINK CAPTAIN MATTHEWS COULD STAND TO LEARN FROM YOU."
msgstr "APUESTO A QUE NO BEBES DEMASIADO, CHAOS. CREO QUE EL CAPITÁN MATTHEWS PODRÍA APRENDER DE TI."

#. habla: ADONIS
#, fuzzy
msgctxt "#24"
msgid "PLEASE HELP ENCOURAGE CAPTAIN MATTHEWS TO CUT DOWN ON HIS ALCOHOL INTAKE!"
msgstr "¡POR FAVOR, AYÚDANOS A CONVENCER AL CAPITÁN MATTHEWS DE QUE BEBA MENOS ALCOHOL!"

#. habla: ADONIS
#, fuzzy
msgctxt "#25"
msgid "HMM. DO HUMANS INGEST ALCOHOL AS A FORM OF FUEL?"
msgstr "HMM. ¿LOS HUMANOS INGIEREN ALCOHOL COMO UNA FORMA DE COMBUSTIBLE?"

#. habla: ADONIS
#, fuzzy
msgctxt "#26"
msgid "WHEN CAPTAIN MATTHEWS COMES HERE, HE ALWAYS SAYS HE'S HERE TO REFUEL."
msgstr "CUANDO EL CAPITÁN MATTHEWS VIENE AQUÍ, SIEMPRE DICE QUE VIENE A CARGAR COMBUSTIBLE."

#. habla: GRASSHOPPER
#, fuzzy
msgctxt "#27"
msgid "ADONIS IS HAVING TROUBLE WITH CAPTAIN MATTHEWS' HANGOVERS. PLEASE GIVE HIM A HAND."
msgstr "ADONIS TIENE PROBLEMAS CON LAS RESACAS DEL CAPITÁN MATTHEWS. POR FAVOR, DALE UNA MANO."

#. habla: GRASSHOPPER
#, fuzzy
msgctxt "#28"
msgid "WHAT DO YOU THINK OF THE MATTHEWS ROBOT THAT THE PROFESSOR DEVELOPED? IT'S PRETTY WELL-MADE, ISN'T IT?"
msgstr "¿QUÉ TE PARECE EL ROBOT MATTHEWS QUE DESARROLLÓ EL PROFESOR? ESTÁ BASTANTE BIEN HECHO, ¿NO?"

#. habla: GRASSHOPPER
#, fuzzy
msgctxt "#29"
msgid "WOULD YOU LIKE TO LEARN ABOUT THE CAPTAIN'S TASTE IN DRINKS?"
msgstr "¿TE GUSTARÍA SABER SOBRE LOS GUSTOS DEL CAPITÁN EN BEBIDAS?"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#30"
msgid ""
"Yes\n"
"No"
msgstr ""
"Sí\n"
"No"

#. habla: GRASSHOPPER
#, fuzzy
msgctxt "#31"
msgid "DESPITE HIS DEMEANOR, THE CAPTAIN ACTUALLY LIKES FRUITY DRINKS LIKE ORANGE JUICE."
msgstr "AUNQUE NO LO PAREZCA, AL CAPITÁN LE GUSTAN LAS BEBIDAS FRUTALES, COMO EL JUGO DE NARANJA."

#. habla: GRASSHOPPER
#, fuzzy
msgctxt "#32"
msgid "FINE, I WON'T TELL YOU."
msgstr "BUENO, NO TE LO CUENTO."

#. habla: GRASSHOPPER
#, fuzzy
msgctxt "#33"
msgid "IF THAT REMEDY DOESN'T WORK, ADONIS WILL BE NEXT IN LINE FOR THE REPAIR SHOP. HA HA HA HA HA."
msgstr "SI ESE REMEDIO NO FUNCIONA, ADONIS VA A SER EL PRÓXIMO EN IR AL TALLER DE REPARACIONES. JA JA JA JA JA."

#. habla: KIR
#, fuzzy
msgctxt "#34"
msgid "ADONIS IS TOO EARNEST FOR HIS OWN GOOD! IT WON'T MAKE ANY DIFFERENCE WHETHER HE FINDS A REMEDY OR NOT! NOBODY HAS HANGOVERS LIKE THE CAPTAIN!"
msgstr "¡ADONIS ES DEMASIADO SERIO PARA SU PROPIO BIEN! ¡DA LO MISMO SI ENCUENTRA UN REMEDIO O NO! ¡NADIE TIENE RESACAS COMO LAS DEL CAPITÁN!"

#. habla: KIR
#, fuzzy
msgctxt "#35"
msgid "BUT, I MUST SAY, I'VE NEVER SEEN A NEW DROID DEVOTE HIMSELF SO COMPLETELY TO A TASK SO QUICKLY!"
msgstr "PERO, TENGO QUE DECIRLO, ¡NUNCA VI A UN DROIDE NUEVO ENTREGARSE TAN RÁPIDO Y POR COMPLETO A UNA TAREA!"

#. habla: KIR
#, fuzzy
msgctxt "#36"
msgid "SHALL I TELL YOU ABOUT THE CAPTAIN'S TASTE IN DRINKS?"
msgstr "¿TE CUENTO SOBRE LOS GUSTOS DEL CAPITÁN EN BEBIDAS?"

#. habla: KIR
#, fuzzy
msgctxt "#37"
msgid "THE CAPTAIN LIKES TOMATO JUICE AND COFFEE ABOUT THE SAME."
msgstr "AL CAPITÁN LE GUSTAN MÁS O MENOS IGUAL EL JUGO DE TOMATE Y EL CAFÉ."

#. habla: KIR
#, fuzzy
msgctxt "#38"
msgid "FINE, I WON'T TELL YOU."
msgstr "BUENO, NO TE LO CUENTO."

#. habla: KIR
#, fuzzy
msgctxt "#39"
msgid "MY SECRET IS SPECIAL. YOU SHOULD LISTEN TO THE OTHERS FIRST."
msgstr "MI SECRETO ES ESPECIAL. PRIMERO DEBERÍAS ESCUCHAR A LOS DEMÁS."

#. habla: KIR
#, fuzzy
msgctxt "#40"
msgid "OH? DID ADONIS GET IT RIGHT? ARE WE SAFE?"
msgstr "¿OH? ¿ADONIS LO LOGRÓ? ¿ESTAMOS A SALVO?"

#. habla: CORONATION
#, fuzzy
msgctxt "#41"
msgid "PLEASE LISTEN TO ADONIS AND HELP HIM WITH HIS PROBLEM."
msgstr "POR FAVOR, ESCUCHA A ADONIS Y AYÚDALO CON SU PROBLEMA."

#. habla: CORONATION
#, fuzzy
msgctxt "#42"
msgid "THE CAPTAIN HAS BEEN UNDER MUCH STRESS LATELY, SO ADONIS MUST FIND SOMETHING QUICKLY."
msgstr "ÚLTIMAMENTE EL CAPITÁN ESTÁ MUY ESTRESADO, ASÍ QUE ADONIS TIENE QUE ENCONTRAR ALGO RÁPIDO."

#. habla: CORONATION
#, fuzzy
msgctxt "#43"
msgid "DO YOU WANT TO KNOW ABOUT THE CAPTAIN'S TASTE IN DRINKS?"
msgstr "¿QUIERES SABER SOBRE LOS GUSTOS DEL CAPITÁN EN BEBIDAS?"

#. habla: CORONATION
#, fuzzy
msgctxt "#44"
msgid "THE CAPTAIN NEVER DRINKS JUST PLAIN ORANGE JUICE."
msgstr "EL CAPITÁN NUNCA TOMA JUGO DE NARANJA SOLO."

#. habla: CORONATION
#, fuzzy
msgctxt "#45"
msgid "FINE, I WON'T TELL YOU."
msgstr "BUENO, NO TE LO CUENTO."

#. habla: CORONATION
#, fuzzy
msgctxt "#46"
msgid "MY SECRET IS SPECIAL. YOU SHOULD LISTEN TO THE OTHERS FIRST."
msgstr "MI SECRETO ES ESPECIAL. PRIMERO DEBERÍAS ESCUCHAR A LOS DEMÁS."

#. habla: CORONATION
#, fuzzy
msgctxt "#47"
msgid "HMM. ADONIS IS ALWAYS THE ONE WHO SUFFERS. WE MUST DO SOMETHING TO HELP."
msgstr "HMM. ADONIS SIEMPRE ES EL QUE SUFRE. TENEMOS QUE HACER ALGO PARA AYUDARLO."

#. habla: MOCKINGBIRD
#, fuzzy
msgctxt "#48"
msgid "HAHAHA, ADONIS IS SO FUNNY! WHAT'S FUNNY ABOUT HIM? TALK TO HIM AND FIND OUT!"
msgstr "JAJAJA, ¡ADONIS ES TAN GRACIOSO! ¿QUÉ TIENE DE GRACIOSO? ¡HABLA CON ÉL Y AVERÍGUALO!"

#. habla: MOCKINGBIRD
#, fuzzy
msgctxt "#49"
msgid "HAHAHA, ADONIS IS SO STUPID! WHAT'S STUPID ABOUT HIM? TALK TO HIM AND FIND OUT!"
msgstr "JAJAJA, ¡ADONIS ES TAN TONTO! ¿QUÉ TIENE DE TONTO? ¡HABLA CON ÉL Y AVERÍGUALO!"

#. habla: MOCKINGBIRD
#, fuzzy
msgctxt "#50"
msgid "DO YOU WANT TO KNOW ABOUT THE CAPTAIN'S TASTE IN DRINKS?"
msgstr "¿QUIERES SABER SOBRE LOS GUSTOS DEL CAPITÁN EN BEBIDAS?"

#. habla: MOCKINGBIRD
#, fuzzy
msgctxt "#51"
msgid "THE CAPTAIN IS ALWAYS SAYING THAT BALANCE IS IMPORTANT!"
msgstr "¡EL CAPITÁN SIEMPRE DICE QUE EL EQUILIBRIO ES IMPORTANTE!"

#. habla: MOCKINGBIRD
#, fuzzy
msgctxt "#52"
msgid "FINE, I WON'T TELL YOU."
msgstr "BUENO, NO TE LO CUENTO."

#. habla: MOCKINGBIRD
#, fuzzy
msgctxt "#53"
msgid "IF YOU WANT TO HEAR MY SECRET, LISTEN TO THE OTHERS FIRST."
msgstr "SI QUIERES ESCUCHAR MI SECRETO, PRIMERO ESCUCHA A LOS DEMÁS."

#. habla: MOCKINGBIRD
#, fuzzy
msgctxt "#54"
msgid "HAHAHA! I CAN'T WAIT UNTIL THE CAPTAIN DROPS BY AGAIN!"
msgstr "¡JAJAJA! ¡NO VEO LA HORA DE QUE EL CAPITÁN VUELVA A PASAR!"

#. habla: ADONIS
#, fuzzy
msgctxt "#55"
msgid "THE DRINK IS COMPLETE. PLEASE HAVE THE MATTHEWS ROBOT ANALYZE IT."
msgstr "LA BEBIDA ESTÁ LISTA. POR FAVOR, HAZ QUE EL ROBOT MATTHEWS LA ANALICE."

#. habla: ADONIS
#, fuzzy
msgctxt "#56"
msgid "CAPTAIN MATTHEWS DESIGNED THIS BAR HIMSELF, SO HE LIKES TO COME HERE. AND WHEN HE COMES, HE DRINKS. A LOT. AND THEN HE'LL BE REALLY FRIENDLY AND PASS OUT. THE PROBLEM COMES THE NEXT DAY WHEN HE GETS AN INCREDIBLE HANGOVER AND BLAMES IT ON THE DROIDS! I KNOW THREE DROIDS THAT HAVE NEEDED MAJOR REPAIRS AFTER THE CAPTAIN WAS DONE WITH THEM! I NEED TO FIND A DRINK THAT WILL HELP HIM GET OVER HIS HANGOVERS QUICKLY. WHAT DO YOU THINK? CAN YOU HELP US POOR ELSA DROIDS OUT?"
msgstr "EL CAPITÁN MATTHEWS DISEÑÓ ESTE BAR ÉL MISMO, ASÍ QUE LE GUSTA VENIR. Y CUANDO VIENE, BEBE. MUCHO. Y DESPUÉS SE PONE MUY AMISTOSO Y SE DESMAYA. EL PROBLEMA LLEGA AL DÍA SIGUIENTE, CUANDO TIENE UNA RESACA INCREÍBLE ¡Y LES ECHA LA CULPA A LOS DROIDES! ¡CONOZCO TRES DROIDES QUE NECESITARON REPARACIONES GRANDES DESPUÉS DE QUE EL CAPITÁN TERMINÓ CON ELLOS! TENGO QUE ENCONTRAR UNA BEBIDA QUE LO AYUDE A SUPERAR RÁPIDO LAS RESACAS. ¿QUÉ DICES? ¿PUEDES AYUDARNOS A LOS POBRES DROIDES DEL ELSA?"

#. habla: ADONIS
#, fuzzy
msgctxt "#57"
msgid "REALLY?! THANK YOU VERY MUCH!"
msgstr "¡¿DE VERDAD?! ¡MUCHÍSIMAS GRACIAS!"

#. habla: ADONIS
#, fuzzy
msgctxt "#59"
msgid "THERE ARE ONLY THREE DRINKS ON THE ELSA THAT DO NOT CONTAIN ALCOHOL. I WANT YOU TO MIX THOSE THREE DRINKS TOGETHER AND MAKE A HANGOVER REMEDY THE CAPTAIN CAN STAND. WHEN YOU TELL ME TO BEGIN MIXING, YOU WILL ENTER THREE DIGITS. THE THREE DIGITS, FROM LEFT TO RIGHT, INDICATE ORANGE JUICE, TOMATO JUICE, AND COFFEE. I'VE FOUND OUT THAT THE THREE DIGITS SHOULD TOTAL SEVEN IN ORDER TO MAKE SOMETHING THE CAPTAIN WILL DRINK, BUT I COULDN'T FIND OUT ANYTHING ELSE. YOU MAY WANT TO ASK MY FRIENDS IN THIS ROOM. PERHAPS THEY KNOW SOMETHING. I'LL LEAVE IT UP TO YOU WHETHER TO TRUST THEM OR NOT. WHEN YOU'RE READY TO MAKE THE REMEDY, COME TALK TO ME. BY THE WAY, I ONLY HAVE ENOUGH FOR FIVE TRIES. IF WE FAIL FIVE TIMES, I WON'T HAVE ENOUGH FOR THE NEXT TIME THE CAPTAIN VISITS! SO PLEASE, USE CAUTION WHEN MIXING THE REMEDIES!"
msgstr "EN EL ELSA SOLO HAY TRES BEBIDAS SIN ALCOHOL. QUIERO QUE MEZCLES ESAS TRES BEBIDAS Y HAGAS UN REMEDIO PARA LA RESACA QUE EL CAPITÁN PUEDA TOLERAR. CUANDO ME PIDAS QUE EMPIECE LA MEZCLA, VAS A INGRESAR TRES DÍGITOS. LOS TRES DÍGITOS, DE IZQUIERDA A DERECHA, INDICAN JUGO DE NARANJA, JUGO DE TOMATE Y CAFÉ. DESCUBRÍ QUE LOS TRES DÍGITOS TIENEN QUE SUMAR SIETE PARA HACER ALGO QUE EL CAPITÁN SE TOME, PERO NO PUDE AVERIGUAR NADA MÁS. TE CONVENDRÍA PREGUNTARLES A MIS AMIGOS DE ESTA SALA. QUIZÁ SEPAN ALGO. TE DEJO A TI DECIDIR SI CREERLES O NO. CUANDO QUIERAS HACER EL REMEDIO, VEN A HABLAR CONMIGO. POR CIERTO, SOLO ME ALCANZA PARA CINCO INTENTOS. SI FALLAMOS CINCO VECES, ¡NO ME VA A ALCANZAR PARA LA PRÓXIMA VEZ QUE VENGA EL CAPITÁN! ASÍ QUE, POR FAVOR, ¡TEN CUIDADO AL MEZCLAR LOS REMEDIOS!"

#. habla: ADONIS
#, fuzzy
msgctxt "#60"
msgid "ALSO, NEAR THE VIP SEAT IS A MATTHEWS ROBOT THAT THE PROFESSOR MADE FOR ME."
msgstr "ADEMÁS, CERCA DEL ASIENTO VIP HAY UN ROBOT MATTHEWS QUE EL PROFESOR HIZO PARA MÍ."

#. habla: ADONIS
#, fuzzy
msgctxt "#61"
msgid "HE TESTS EVERYTHING I MAKE IN PLACE OF THE BUSY CAPTAIN. ONCE YOU FINISH MAKING A REMEDY, PLEASE TALK TO THE MATTHEWS ROBOT."
msgstr "PRUEBA TODO LO QUE PREPARO EN LUGAR DEL CAPITÁN, QUE ESTÁ MUY OCUPADO. CUANDO TERMINES DE HACER UN REMEDIO, POR FAVOR, HABLA CON EL ROBOT MATTHEWS."

#. habla: ADONIS
#, fuzzy
msgctxt "#62"
msgid "I SEE. IF YOU DECIDE TO HELP US, COME BACK ANYTIME! YOU'RE ALWAYS WELCOME."
msgstr "YA VEO. SI DECIDES AYUDARNOS, ¡VUELVE CUANDO QUIERAS! LAS PUERTAS SIEMPRE ESTÁN ABIERTAS."

#. habla: ADONIS
#, fuzzy
msgctxt "#63"
msgid "YOU DID IT! YOU'VE FOUND THE REMEDY THE CAPTAIN WILL TAKE! I DON'T HAVE TO WORRY ANYMORE!"
msgstr "¡LO LOGRASTE! ¡ENCONTRASTE EL REMEDIO QUE EL CAPITÁN VA A TOMAR! ¡YA NO TENGO QUE PREOCUPARME!"

#. habla: ADONIS
#, fuzzy
msgctxt "#65"
msgid "WE COULDN'T HAVE DONE IT WITHOUT YOU! I'M GLAD I ASKED YOU! PLEASE TAKE THIS AS MY THANKS!"
msgstr "¡NO LO HABRÍAMOS LOGRADO SIN TI! ¡ME ALEGRA HABERTE PEDIDO AYUDA! ¡POR FAVOR, ACEPTA ESTO COMO AGRADECIMIENTO!"

#, fuzzy
msgctxt "#66"
msgid "You obtained Decoder 14!"
msgstr "¡Obtuviste el Decodificador 14!"

#. habla: ADONIS
#, fuzzy
msgctxt "#67"
msgid "IT PROBABLY SOUNDS STRANGE, BUT THIS EXPERIENCE HAS GIVEN ME CONFIDENCE AS A BARTENDER! NOW I WANT THE CAPTAIN TO COME DRINK HERE MORE OFTEN!!"
msgstr "QUIZÁ SUENE RARO, ¡PERO ESTA EXPERIENCIA ME DIO CONFIANZA COMO BARMAN! ¡AHORA QUIERO QUE EL CAPITÁN VENGA A BEBER AQUÍ MÁS A MENUDO!"

#. habla: ADONIS
#, fuzzy
msgctxt "#68"
msgid "OH, DEAR. YOU COULDN'T MAKE A REMEDY THAT WOULD SATISFY THE CAPTAIN."
msgstr "AY, NO. NO PUDISTE HACER UN REMEDIO QUE DEJARA SATISFECHO AL CAPITÁN."

#. habla: ADONIS
#, fuzzy
msgctxt "#70"
msgid "I'M SORRY TO HAVE TROUBLED YOU. PLEASE, TAKE THIS AS MY THANKS!"
msgstr "PERDÓN POR LAS MOLESTIAS. ¡POR FAVOR, ACEPTA ESTO COMO AGRADECIMIENTO!"

#. habla: ADONIS
#, fuzzy
msgctxt "#71"
msgid "WHEN YOU STOP AND THINK ABOUT IT, IT'S MY OWN FAULT THAT I COULDN'T SATISFY THE CAPTAIN. AS A BARTENDER, I'M RESPONSIBLE FOR MY CUSTOMERS' WELL-BEING, TOO. I'M GOING TO KEEP STUDYING AND TAKE CARE OF THE CAPTAIN THE BEST I CAN!"
msgstr "SI LO PIENSO BIEN, ES CULPA MÍA NO HABER PODIDO SATISFACER AL CAPITÁN. COMO BARMAN, TAMBIÉN SOY RESPONSABLE DEL BIENESTAR DE MIS CLIENTES. ¡VOY A SEGUIR ESTUDIANDO Y A CUIDAR AL CAPITÁN LO MEJOR QUE PUEDA!"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#72"
msgid "YOU BETTER BRING ME SOMETHING GOOD THIS TIME!"
msgstr "¡MÁS VALE QUE ESTA VEZ ME TRAIGAS ALGO BUENO!"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#73"
msgid "EWW, YUCK! WHO MADE THIS AWFUL DRINK?! WHAT?! ARE YOU TRYING TO KILL ME?"
msgstr "¡PUAJ, QUÉ ASCO! ¡¿QUIÉN HIZO ESTA BEBIDA HORRIBLE?! ¡¿QUÉ?! ¿QUIERES MATARME?"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#74"
msgid "YOU HAVE FOUR CHANCES LEFT!"
msgstr "¡TE QUEDAN CUATRO OPORTUNIDADES!"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#75"
msgid "YOU HAVE THREE CHANCES LEFT!"
msgstr "¡TE QUEDAN TRES OPORTUNIDADES!"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#76"
msgid "YOU HAVE TWO CHANCES LEFT!"
msgstr "¡TE QUEDAN DOS OPORTUNIDADES!"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#77"
msgid "YOU HAVE ONE CHANCE LEFT!"
msgstr "¡TE QUEDA UNA OPORTUNIDAD!"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#78"
msgid "NOT BAD! TELL ADONIS THIS TASTES GOOD!"
msgstr "¡NADA MAL! ¡DILE A ADONIS QUE ESTO ESTÁ RICO!"

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#79"
msgid "GAH, THIS TASTES TERRIBLE! IT LOOKS LIKE I'LL JUST HAVE TO SLEEP IT OFF! WELL, TELL ADONIS HE DID A GOOD JOB, ANYWAY."
msgstr "¡PUAJ, ESTO ES ESPANTOSO! ¡PARECE QUE VOY A TENER QUE CURARLA DURMIENDO! BUENO, DE TODOS MODOS, DILE A ADONIS QUE HIZO UN BUEN TRABAJO."

#. habla: MATTHEWS ROBOT
#, fuzzy
msgctxt "#80"
msgid "THE SIMULATION TO ANALYZE THE CAPTAIN'S HANGOVER REMEDY IS COMPLETE."
msgstr "LA SIMULACIÓN PARA ANALIZAR EL REMEDIO PARA LA RESACA DEL CAPITÁN ESTÁ COMPLETA."
