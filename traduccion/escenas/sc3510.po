#, fuzzy
msgctxt "#0"
msgid "Use the elevator?"
msgstr "¿Usar el ascensor?"

#. Opciones: una por línea. Mantener 2 líneas en el mismo orden.
#, fuzzy
msgctxt "#1"
msgid ""
"Yes\n"
"No"
msgstr ""
"Sí\n"
"No"

#, fuzzy
msgctxt "#2"
msgid "There is a button with instructions."
msgstr "Hay un botón con instrucciones."

#. Opciones: una por línea. Mantener 3 líneas en el mismo orden.
#, fuzzy
msgctxt "#3"
msgid ""
"Read the instructions.\n"
"Reset the blocks.\n"
"Don't do anything."
msgstr ""
"Leer las instrucciones.\n"
"Reiniciar los bloques.\n"
"No hacer nada."

#, fuzzy
msgctxt "#4"
msgid "The elevator rests on an industrial weight-resistant coil. Place cargo on the platform to lower it by degrees. It can be raised again by removing the load."
msgstr "El ascensor descansa sobre una bobina industrial resistente al peso. Coloca carga en la plataforma para bajarla gradualmente. Se puede volver a subir quitando la carga."

#, fuzzy
msgctxt "#5"
msgid "This is the elevator's current status."
msgstr "Este es el estado actual del ascensor."
